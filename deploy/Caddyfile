# ═══════════════════════════════════════════════════════════════════════════
# الحافة — ومصدر الشهادة.
#
# **المشكلة التي يحلّها هذا الملف ليست تقنية بل مشهدية:** عرضٌ على عنوان IP
# عارٍ فوق HTTP يُظهر تحذير متصفّح أمام صاحب القرار، وهو نقيض «عرض مُبهر»
# بالضبط. والحلّ ليس اختياراً هندسياً بل قراراً يملكه المالك، لأنه يبدأ باسم
# نطاق يملكه هو — **أو بعنوان IP ثابت يملكه، منذ 2026-01-15.**
#
# أربعة أوضاع، والفرق بينها هو ما يراه المتصفّح لا ما يشعر به المهندس:
#
#   BABEL_TLS_MODE=auto      + BABEL_SITE=demo.example.sa
#       شهادة عامة تلقائية (‏ACME). **لا تحذير على أي جهاز.** وهو الوضع
#       الوحيد الذي يعمل على جهاز لم يُهيَّأ مسبقاً — جهاز الضيف مثلاً.
#       يتطلّب: نطاقاً يشير إلى الخادم، والمنفذين 80 و443 مفتوحين للعالم.
#
#   BABEL_TLS_MODE=ip        + BABEL_SITE=https://203.0.113.10
#                            + BABEL_TLS_IP=203.0.113.10
#       شهادة عامة **على عنوان IP عارٍ** من Let's Encrypt بملمح `shortlived`.
#       **لا تحذير على أي جهاز، وبلا نطاق.** وثمنها عمرٌ قدره 160 ساعة
#       (‏~6.7 يوم)، فالتجديد ليس صيانةً بل شرطَ بقاء — README §3.
#
#   BABEL_TLS_MODE=internal  + BABEL_SITE=https://203.0.113.10
#       شهادة من سلطة Caddy الداخلية. **لا تحذير على جهاز العرض وحده**
#       بعد تثبيت جذر تلك السلطة عليه مرّة واحدة (‏README §3). ولا نطاق مطلوب.
#       وهو الوضع المقصود حين يقتصر العرض على جهاز واحد معروف مسبقاً.
#
#   BABEL_TLS_MODE=auto      + BABEL_SITE=:80
#       ‏HTTP عارٍ. **تحذير مؤكَّد أمام الضيف**، ولا يصلح لعرض.
#       موجود للتشغيل المحلي وللفحص الأول بعد النشر لا أكثر.
#
# **وما لا يوجد هنا وضعاً: `auto` بعنوان IP.** هو يبدو أنه يعمل ولا يعمل:
# ‏Caddy عند غياب مُصدِر صريح يُسنِد كل موضوع من نوع IP إلى **سلطته الداخلية**
# لا إلى Let's Encrypt، فيصدر شهادةً موقّعة ذاتياً **بلا سطر تحذير واحد** في
# السجلّ — أي هبوطٌ صامت من موثوقة إلى غير موثوقة. سير عمل النشر يرفض هذه
# التركيبة قبل أن يلمس الخادم (‏فخ-جديد · `deploy/README.md §3`).
# ═══════════════════════════════════════════════════════════════════════════

{
	# ‏**الاقتباس هنا ليس تجميلاً، وسببه عطلٌ وقع مرّتين:**
	#
	#   ١ · `email {$VAR}` بقيمة فارغة ليس «بلا بريد» بل **خطأ نحوي** يُفشل تحليل
	#       الملفّ كلّه — أي أن الحافة لا تقلع، فلا يُخدَم شيء:
	#       `wrong argument count or unexpected line ending after 'email'`.
	#   ٢ · و`{$VAR:بديل}` **لا يعالجه**: بديل Caddy يعمل حين يكون المتغيّر
	#       **غير مضبوط**، لا حين يكون مضبوطاً وفارغاً — وهو ما يمرّره compose
	#       دائماً. أُصلح ظنّاً، فعاد العطل بالرسالة نفسها على السطر التالي.
	#
	# والاقتباس يجعل القيمة الفارغة **وسيطاً واحداً فارغاً** لا غياب وسيط، فيمرّ
	# التحليل. والبديل من نطاق `.invalid` مُعلَن الزيف، ولا يُستعمل في الوضعين
	# اللذين لا يتّصلان بسلطة شهادات. أمّا `auto` بنطاق حقيقي فيلزمه بريد حقيقي،
	# **وسير عمل النشر يرفض النشر بدونه** قبل أن يلمس الخادم.
	email "{$BABEL_TLS_EMAIL:tls-email-not-set@invalid}"

	# ── اسم الخادم الافتراضي — وهو **شرط عمل وضع `ip` لا تحسينٌ فيه** ────────
	#
	# متصفّحٌ يفتح `https://203.0.113.10` **لا يرسل SNI إطلاقاً**: امتداد SNI
	# لا يقبل عنواناً حرفياً (‏RFC 6066 §3). وعند غياب SNI يختار CertMagic
	# الشهادة بعنوان **الطرف المحلي للاتصال**، وهو داخل حاوية على شبكة جسرية
	# عنوانٌ خاصّ (‏172.x) لا العنوان العام — لأن نشر المنفذ يترجم الوجهة.
	# فالنتيجة بلا هذا السطر: شهادةٌ صحيحة مُصدَرة ومخزَّنة، و**مصافحة تفشل**
	# لأن لا شيء يطابق `172.18.0.5`.
	#
	# وهذا السطر يجعل الاتصال بلا SNI يُقرأ باسم العنوان العام، فتُقدَّم شهادته.
	# ويبقى **فارغاً في الأوضاع الثلاثة الأخرى**، وسير عمل النشر يضمن ذلك:
	# قيمةٌ غير فارغة مع `BABEL_SITE=:80` تجعل Caddy نفسه يرفض الإعداد
	# («‏server listening on [:80] is HTTP, but attempts to configure TLS
	# connection policies») — وهو رفضٌ صحيح لتركيبة لا معنى لها.
	default_sni "{$BABEL_TLS_IP}"

	# لوحة الإدارة مطفأة: واجهة تحكّم مفتوحة داخل الشبكة ليست حاجة عرض.
	admin off
}

(tls-auto) {
}

(tls-internal) {
	tls internal
}

# ── الوضع الرابع: شهادة عامة على عنوان IP عارٍ ──────────────────────────────
#
# ثلاثة أشياء في هذه الكتلة، ولا واحد منها زينة:
#
#   ١ · **`issuer acme` صريحاً.** بدونه لا يذهب Caddy إلى Let's Encrypt أصلاً
#       على موضوعٍ من نوع IP، بل إلى سلطته الداخلية بصمت (انظر صدر الملف).
#       والمُصدِر الصريح يحمل بريده بنفسه: البريد العام أعلاه لمُصدِرات
#       Caddy الافتراضية وحدها.
#
#   ٢ · **`profile shortlived`.** سياسة Let's Encrypt: شهادة تحمل عنوان IP
#       **يجب** أن تكون قصيرة العمر، وهذا الملمح هو الوحيد الذي يقبل مُعرِّفات
#       من نوع `IP` (‏letsencrypt.org/docs/profiles). طلبٌ بلا هذا الملمح
#       **يُرفض من الخادم** لا يُخفَّض.
#
#   ٣ · **`disable_tlsalpn_challenge`.** تحدّي DNS مستحيل على عنوان، فيبقى
#       اثنان. و`tls-alpn-01` **غير قابل للحلّ في هذا الإعداد**: خادم
#       Let's Encrypt يفتح المصافحة باسم عكسي (`…in-addr.arpa`) — وهو ما
#       يفرضه RFC 8738 لأن SNI لا يقبل عنواناً — وسياسةُ الاتصال هنا
#       مُقيَّدة بـ`sni` تطابق العنوان والفراغ، فلا تطابقه فتسقط المصافحة.
#       وكل محاولة ساقطة تستهلك من حدّ «خمس إخفاقات تفويض لكل مُعرِّف في
#       الساعة». فيُقفَل الباب صراحةً، ويبقى `http-01` — وهو يتطلّب أن يكون
#       **المنفذ 80 مفتوحاً للعالم**، وذلك مكتوب في README §2.
(tls-ip) {
	tls {
		issuer acme {
			email "{$BABEL_TLS_EMAIL:tls-email-not-set@invalid}"
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
}

{$BABEL_SITE} {
	import tls-{$BABEL_TLS_MODE}

	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# الحافة لا تعرف الخلفية: كل شيء يذهب إلى الواجهة، وهي التي توجّه /api
	# و/health إلى الخادم على الأصل نفسه (deploy/nginx.conf). موضعُ التوجيه
	# واحد لا اثنان، فلا ينحرف أحدهما عن الآخر.
	reverse_proxy web:8080
}
