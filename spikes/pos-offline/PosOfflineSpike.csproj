<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BabelPosOffline</RootNamespace>
    <AssemblyName>BabelPosOffline</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- الجهاز: مخزن محلي مضمّن / device: embedded local store -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- الخادم: PostgreSQL خالص، بلا Marten (انظر spikes/relational-stack/VERDICT.md) -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
