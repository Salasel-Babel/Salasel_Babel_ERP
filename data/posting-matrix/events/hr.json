          "amount": "provision_utilised",
          "dimensions": [],
          "subledger": "employee",
          "when": null,
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 2,
          "line_kind": "role",
          "role": "eos_expense",
          "qualifier_source": null,
          "side": "debit",
          "amount": "shortfall",
          "dimensions": [
            "cost_center"
          ],
          "subledger": null,
          "when": "provision_short",
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 3,
          "line_kind": "role",
          "role": "eos_expense",
          "qualifier_source": null,
          "side": "credit",
          "amount": "excess",
          "dimensions": [
            "cost_center"
          ],
          "subledger": null,
          "when": "provision_excess",
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 4,
          "line_kind": "role",
