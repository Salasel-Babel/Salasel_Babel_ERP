    {
      "event_code": "hr.end_of_service.settlement",
      "name_ar": "صرف مكافأة نهاية الخدمة",
      "name_en": "End-of-service benefit settlement",
      "module": "hr",
      "status": "drafted",
      "source_ref": "posting-matrix.md §7.3",
      "trigger": {
        "name_ar": "عند انتهاء خدمة الموظف واعتماد المخالصة",
        "name_en": "On termination of service and approval of the final settlement"
      },
      "posts_entry": true,
      "reversal": {
        "name_ar": "قيد عكسي مستقل",
        "name_en": "A separate reversing entry"
      },
      "amounts": {
        "amount_paid": {
          "name_ar": "المبلغ المصروف للموظف",
          "name_en": "Amount paid to the employee",
          "derivation_ar": "من حساب المخالصة المعتمد",
          "derivation_en": "From the approved final settlement calculation"
        },
        "provision_utilised": {
          "name_ar": "المخصص المستنفَد",
          "name_en": "Provision utilised",
          "derivation_ar": "رصيد المخصص المكوَّن لهذا الموظف",
          "derivation_en": "The provision balance built up for this employee"
        },
        "shortfall": {
          "name_ar": "العجز في المخصص",
          "name_en": "Provision shortfall",
          "derivation_ar": "حين يقل المخصص عن المستحق — يُحمَّل على مصروف الفترة",
          "derivation_en": "When the provision falls short of the amount due — charged to the period expense"
        },
        "excess": {
          "name_ar": "الزيادة في المخصص",
          "name_en": "Provision excess",
          "derivation_ar": "حين يزيد المخصص عن المستحق — يُرد إلى مصروف الفترة",
          "derivation_en": "When the provision exceeds the amount due — released back to the period expense"
        }
      },
      "identities": {
        "provision_utilised": "amount_paid - shortfall + excess"
      },
      "conditions": {
        "provision_short": {
          "name_ar": "المخصص أقل من المستحق",
          "name_en": "The provision is below the amount due",
          "expression": "provision_balance < settlement_due"
        },
        "provision_excess": {
          "name_ar": "المخصص أكبر من المستحق",
          "name_en": "The provision exceeds the amount due",
          "expression": "provision_balance > settlement_due"
        }
      },
      "scenarios": [
        {
          "code": "exact",
          "name_ar": "المخصص مطابق",
          "name_en": "Provision matches",
          "true_conditions": [],
          "zero_amounts": [
            "shortfall",
            "excess"
          ]
        },
        {
          "code": "short",
          "name_ar": "المخصص ناقص",
          "name_en": "Provision short",
          "true_conditions": [
            "provision_short"
          ],
          "zero_amounts": [
            "excess"
          ]
        },
        {
          "code": "excess",
          "name_ar": "المخصص زائد",
          "name_en": "Provision in excess",
          "true_conditions": [
            "provision_excess"
          ],
          "zero_amounts": [
            "shortfall"
          ]
        }
      ],
      "lines": [
        {
          "line_no": 1,
          "line_kind": "role",
          "role": "eos_provision",
          "qualifier_source": null,
