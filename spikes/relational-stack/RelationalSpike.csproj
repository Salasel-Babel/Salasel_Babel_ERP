<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BabelRelationalSpike</RootNamespace>
    <AssemblyName>BabelRelationalSpike</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Messaging: Wolverine WITHOUT Marten. -->
    <PackageReference Include="WolverineFx" Version="6.29.2" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.29.2" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.29.2" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.29.2" />

    <!-- Persistence: EF Core 10 + Npgsql. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
