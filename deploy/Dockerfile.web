# ═══════════════════════════════════════════════════════════════════════════
# صورة الواجهة: بناء بـNode، وتقديم بـnginx.
#
# ‏**بلا Node في صورة التشغيل**: ما يصل الخادم ملفّات ثابتة لا عملية جافاسكربت.
# وبوّابة انحراف العقد (npm run gen:check) تعمل في web.yml لا هنا: صورةٌ تفشل
# لسبب عقدٍ منحرف تُخفي البلاغ داخل سجلّ بناء بدل أن ترفعه في المكان الذي
# يقرؤه المؤلف.
# ═══════════════════════════════════════════════════════════════════════════
FROM node:22-bookworm-slim AS build
WORKDIR /source

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY --from=build /source/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
    CMD wget --quiet --spider http://127.0.0.1:8080/index.html || exit 1
