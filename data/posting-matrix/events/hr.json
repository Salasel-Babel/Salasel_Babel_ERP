      "event_code": "hr.end_of_service.accrual",
      "name_ar": "استحقاق مخصص مكافأة نهاية الخدمة",
      "name_en": "End-of-service benefits provision accrual",
      "module": "hr",
      "status": "drafted",
      "source_ref": "posting-matrix.md §7.3",
      "trigger": {
        "name_ar": "دورياً في نهاية كل فترة",
        "name_en": "Periodically at each period end"
      },
      "posts_entry": true,
      "reversal": {
        "name_ar": "تعديل التقدير بقيد مستقل لا بتعديل القيد السابق",
        "name_en": "An estimate change is a separate entry never an edit of the previous one"
      },
      "caveats": [
        {
          "ref": "chart-of-accounts.md",
          "text_ar": "⚠️ طريقة قياس مخصص نهاية الخدمة ومدخلاتها تحتاج اعتماد المحاسب القانوني",
          "text_en": "⚠️ The measurement method of the end-of-service provision and its inputs need chartered accountant approval"
        }
      ],
      "amounts": {
        "period_share": {
          "name_ar": "حصة الفترة من المخصص",
          "name_en": "The period share of the provision",
          "derivation_ar": "بطريقة القياس المعتمدة — لا تُخترع في هذا التسليم",
          "derivation_en": "By the approved measurement method — not invented in this deliverable"
        }
      },
      "lines": [
        {
          "line_no": 1,
          "line_kind": "role",
          "role": "eos_expense",
          "qualifier_source": null,
          "side": "debit",
          "amount": "period_share",
          "dimensions": [
            "cost_center"
          ],
