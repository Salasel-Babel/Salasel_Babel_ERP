  "events": [
    {
      "event_code": "projects.client_certificate.posted",
      "name_ar": "مستخلص عميل — إثبات الإيراد",
      "name_en": "Client interim payment certificate — revenue recognition",
      "module": "projects",
      "status": "drafted",
      "source_ref": "posting-matrix.md §5.1",
      "trigger": {
        "name_ar": "عند اعتماد المستخلص من العميل وإصدار الفاتورة الضريبية",
        "name_en": "On the client approving the certificate and issuing the tax invoice"
      },
      "posts_entry": true,
      "reversal": {
        "name_ar": "إشعار دائن مرتبط بالمستخلص الأصلي",
        "name_en": "A credit note linked to the original certificate"
      },
      "caveats": [
        {
          "ref": "posting-matrix.md بند مفتوح 5",
          "text_ar": "⚠️ أساس الاعتراف بالإيراد في المقاولات (نسبة الإنجاز أم عند التسليم) غير محسوم ويؤثر جوهرياً على توقيت هذا القيد",
          "text_en": "⚠️ The contracting revenue recognition basis (percentage of completion vs on delivery) is unresolved and materially affects the timing of this entry"
        },
        {
          "ref": "posting-matrix.md بند مفتوح 6",
          "text_ar": "⚠️ تصنيف المحتجزات أصلاً متداولاً أم غير متداول غير محسوم",
          "text_en": "⚠️ Classifying retention as a current or non-current asset is unresolved"
        }
      ],
      "amounts": {
        "work_value": {
          "name_ar": "قيمة الأعمال المنفذة في الفترة",
          "name_en": "Value of works executed in the period",
          "derivation_ar": "من بنود جدول الكميات المعتمدة في المستخلص",
          "derivation_en": "From the approved BOQ lines in the certificate"
        },
        "tax": {
          "name_ar": "ضريبة المخرجات",
          "name_en": "Output VAT",
          "derivation_ar": "حسب التصنيف الضريبي لبنود العقد",
          "derivation_en": "Per the tax classification of the contract lines"
        },
        "retention": {
          "name_ar": "المحتجز",
          "name_en": "Retention",
          "derivation_ar": "بنسبة المحتجز المنصوص عليها في العقد — لا نسبة في الكود",
          "derivation_en": "At the retention percentage stated in the contract — never a rate in code"
        },
        "advance_recovery": {
          "name_ar": "استرداد الدفعة المقدمة",
          "name_en": "Advance recovery",
          "derivation_ar": "بقاعدة الاسترداد في العقد",
          "derivation_en": "By the recovery rule in the contract"
        }
      },
      "conditions": {
        "has_retention": {
          "name_ar": "العقد ينص على محتجز",
          "name_en": "The contract provides for retention",
          "expression": "contract.retention_rate > 0"
        },
        "has_advance_recovery": {
          "name_ar": "توجد دفعة مقدمة تُسترد",
          "name_en": "An advance is being recovered",
          "expression": "contract.advance_balance > 0"
        }
      },
      "scenarios": [
        {
          "code": "full",
          "name_ar": "محتجز واسترداد دفعة",
          "name_en": "Retention and advance recovery",
          "true_conditions": [
            "has_retention",
            "has_advance_recovery"
          ]
        },
        {
          "code": "no_retention",
          "name_ar": "بلا محتجز",
          "name_en": "No retention",
          "true_conditions": [
            "has_advance_recovery"
          ],
          "zero_amounts": [
            "retention"
          ]
        },
        {
          "code": "no_advance",
          "name_ar": "بلا استرداد دفعة",
          "name_en": "No advance recovery",
          "true_conditions": [
            "has_retention"
          ],
          "zero_amounts": [
            "advance_recovery"
          ]
        }
      ],
      "lines": [
        {
          "line_no": 1,
          "line_kind": "role",
          "role": "ar_customer_control",
          "qualifier_source": null,
          "side": "debit",
          "amount": "work_value + tax - retention - advance_recovery",
          "dimensions": [],
          "subledger": "customer",
          "when": null,
          "note_ar": "",
          "note_en": ""
