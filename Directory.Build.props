<Project>

  <!--
    الإعدادات الملزمة لكل مشاريع «سلاسل بابل».
    Baseline settings enforced across every Babel project.
    قاعدة: لا يُعطَّل أي بند هنا داخل مشروع منفرد. التعطيل يكون هنا وبتوثيق.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- تحذير واحد = بناء فاشل. لا استثناء. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>

    <!-- المحلّلات مفعّلة، وقواعد الأسلوب تُفحص أثناء البناء لا في المحرّر وحده. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- ملف التوثيق مطلوب لتشغيل IDE0005 (using غير مستعمل) أثناء البناء. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- بناء حتمي: الناتج نفسه من المصدر نفسه، مستقلاً عن المسار والجهاز. -->
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</DeterministicSourcePaths>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PathMap Condition="'$(ContinuousIntegrationBuild)' == 'true'">$(MSBuildThisFileDirectory)=/_/</PathMap>

    <!--
      العربية لغة أولى: لا تُعطَّل بيانات المناطق. §16 من وثيقة المعمارية.

      وهذا ليس اختياراً أسلوبياً ولا موضعه مشروع واحد. مقيس على هذا الجهاز:
      تحت DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 يصير String.Normalize عملية لا شيء
      **بصمت**، ويُرجع IsNormalized(FormC) القيمة true لنصّ غير مطبَّع، فتُجزَّأ كل سلسلة
      عربية تحمل أ/إ/آ تجزئةً مختلفة **بلا استثناء واحد ولا سطر سجل**.
      لذلك يعيش الإعداد هنا لا في csproj منفرد: مشروع واحد يفوته يكفي لكسر السلسلة.
      حارس موجب في التكامل المستمر: وظيفة invariant-globalization-guard في ci.yml،
      وحارس وقت التحميل في src/Babel.Canonicalization/CanonicalRuntime.cs.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- إدارة إصدارات الحزم مركزياً: Directory.Packages.props هو المصدر الوحيد. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1848</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- اختبارات المعمارية تفحص الأنواع بالانعكاس؛ CA1707 وأمثاله لا يخدمان أسماء الاختبارات. -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA5394;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <PackageReference Include="xunit.v3" />

    <!--
      إعداد المشغّل يُنسخ إلى مُخرَج **كل** مشروع اختبار من ملفٍّ واحد في الجذر.
      وفيه سطرٌ واحد يهمّ: مهلةُ انتظار خيوط المقدّمة عند الإغلاق.

      **ولماذا رُفعت من عشرٍ إلى ستين:** مجموعةٌ تمرّ **كلّها** ثم تخرج العملية برمزٍ غير
      صفري لأن خيطاً لم ينتهِ في عشر ثوانٍ. وقيسَ أن ذلك **بطءُ جدولة لا تسريبُ خيط**:
      المجموعة نفسها تُغلق في المهلة وحدها، وتتجاوزها حين يعمل غيرها على الآلة (متوسط
      حِمل 24.8 وقت السقوط). وخيطٌ مُسرَّب حقّاً كان سيسقط في الحالتين، فرفعُ المهلة
      **لا يُخفي تسريباً**: يفرّق بين البطء والتسريب بدل أن يخلطهما. (‏فخ-120)
    -->
    <Content Include="$(MSBuildThisFileDirectory)xunit.runner.json"
             Link="xunit.runner.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
