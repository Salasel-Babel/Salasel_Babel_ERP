# ══════════════════════════════════════════════════════════════════════════
# شيفرة مولَّدة: هجرات EF Core ولقطة النموذج.
#
# هذا المجلد **لا يُكتب بيد**: `dotnet ef migrations add` يولّد ما فيه، وأي
# تعديل يدوي يُمحى عند التوليد التالي. ولذلك تُعطَّل هنا — وهنا وحده —
# قواعد الأسلوب التي تخصّ شيفرة يكتبها إنسان:
#
#   IDE0005 · IDE0161 · CA1861   أسلوب المولِّد، لا أسلوبنا.
#
# وما **لا** يُعطَّل: لا شيء من قواعد الصحّة، ولا قاعدة معمارية واحدة. حدود
# المشروع تبقى مفروضة على هذا المجلد كما على غيره — الهجرة لا تستطيع أن تجعل
# نوع استمرارية عاماً ولا أن تُدخل float إلى عمود مالي.
#
# القاعدة العامة في Directory.Build.props تبقى كما هي: التعطيل موثَّق، ونطاقه
# أضيق ما يمكن.
# ══════════════════════════════════════════════════════════════════════════
[*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
