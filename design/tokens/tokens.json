{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$meta": {
    "name": "Salasel Babel ERP Design Tokens",
    "name_ar": "رموز تصميم نظام سلاسل بابل",
    "version": "1.0.0",
    "source": "docs/prototypes/journal-entry/index.html",
    "source_status": "approved",
    "mirror_of": ["design/tokens/tokens.css", "design/theme/theme-default.css"],
    "note_ar": "مرآة آلية القراءة. قيم الألوان خرجت إلى design/theme/theme-default.css فصارت إعداد عميل؛ والطبقة الدلالية في tokens.css هي العقد الثابت. أي تغيير يقع في الملفات معاً.",
    "note_en": "Machine-readable mirror. Colour values now live in design/theme/theme-default.css (per-client theming); the semantic layer in tokens.css is the stable contract. Any change must land in both.",
    "direction_note_ar": "لا اتجاه ثابت للمنتج: الاتجاه خاصية اللغة ويأتي من ملفّ اللغة.",
    "direction_note_en": "The product has no fixed direction; direction is a property of the locale.",
    "source_language": "ar",
    "locales": ["ar", "en", "ur", "hi"],
    "locales_manifest": "design/i18n/locales/manifest.js",
    "locales_note_ar": "لغة خامسة = ملفّ واحد + سطر في manifest.js. لا يوجد «لغة ثانية» في هذا النظام.",
    "locales_note_en": "A fifth locale is one file plus one manifest line. There is no 'secondary language' in this system."
  },

  "color": {
    "core": {
      "bg":            { "light": "#eef2f7", "dark": "#0a1120", "role_ar": "خلفية الصفحة" },
      "surface":       { "light": "#ffffff", "dark": "#111c2f", "role_ar": "سطح البطاقة" },
      "surface-2":     { "light": "#f8fafc", "dark": "#0e1728", "role_ar": "سطح مرتفع/تظليل صف" },
      "surface-3":     { "light": "#f1f5f9", "dark": "#16233a", "role_ar": "سطح غائر/رأس جدول" },
      "border":        { "light": "#e2e8f0", "dark": "#1e2c45", "role_ar": "حدّ عادي" },
      "border-2":      { "light": "#cbd5e1", "dark": "#2b3d5c", "role_ar": "حدّ حقل إدخال" },
      "text":          { "light": "#0f172a", "dark": "#e6edf7", "role_ar": "نص أساسي" },
      "text-2":        { "light": "#475569", "dark": "#9db0ca", "role_ar": "نص ثانوي" },
      "text-3":        { "light": "#94a3b8", "dark": "#6b7f9c", "role_ar": "نص خافت" },
      "brand":         { "light": "#2563eb", "dark": "#60a5fa", "role_ar": "لون العلامة" },
      "brand-ink":     { "light": "#1d4ed8", "dark": "#93c5fd", "role_ar": "العلامة عند التمرير" },
      "brand-soft":    { "light": "#eff6ff", "dark": "#16294d", "role_ar": "خلفية العلامة الخفيفة" },
      "brand-mark-accent": { "light": "#7c3aed", "dark": "#7c3aed", "role_ar": "طرف تدرّج الشعار (قيمة حرفية في النموذج المعتمد في السمتين)" },
      "debit":         { "light": "#0f9d8f", "dark": "#2dd4bf", "role_ar": "المدين" },
      "debit-soft":    { "light": "#ecfdf7", "dark": "#0b2f2c", "role_ar": "خلفية المدين" },
      "credit":        { "light": "#3b82f6", "dark": "#60a5fa", "role_ar": "الدائن" },
      "credit-soft":   { "light": "#eff6ff", "dark": "#16294d", "role_ar": "خلفية الدائن" },
      "good":          { "light": "#16a34a", "dark": "#4ade80", "role_ar": "نجاح" },
      "good-soft":     { "light": "#f0fdf4", "dark": "#0a2c18", "role_ar": "خلفية النجاح" },
      "good-line":     { "light": "#bbf7d0", "dark": "#166534", "role_ar": "حدّ النجاح" },
      "warn":          { "light": "#b45309", "dark": "#fbbf24", "role_ar": "تحذير" },
      "warn-soft":     { "light": "#fffbeb", "dark": "#31240a", "role_ar": "خلفية التحذير" },
      "warn-line":     { "light": "#fde68a", "dark": "#78500b", "role_ar": "حدّ التحذير" },
      "ai":            { "light": "#7c3aed", "dark": "#a78bfa", "role_ar": "المساعد الذكي" },
      "ai-soft":       { "light": "#f5f3ff", "dark": "#241a4d", "role_ar": "خلفية المساعد" },
      "ai-line":       { "light": "#ddd6fe", "dark": "#4c3a91", "role_ar": "حدّ المساعد" },
      "req":           { "light": "#dc2626", "dark": "#f87171", "role_ar": "خطر / حقل إلزامي" },
      "req-soft":      { "light": "color-mix(in srgb, var(--req) 10%, var(--surface))", "dark": "color-mix(in srgb, var(--req) 14%, var(--surface))", "derived": true, "role_ar": "خلفية الخطر — مشتقّة بنفس أسلوب النموذج" },
      "req-line":      { "light": "color-mix(in srgb, var(--req) 34%, var(--surface))", "dark": "color-mix(in srgb, var(--req) 40%, var(--surface))", "derived": true, "role_ar": "حدّ الخطر — مشتقّ" },
      "on-brand":      { "light": "#ffffff", "dark": "#ffffff", "role_ar": "نص فوق العلامة", "note_ar": "مطابق للنموذج المعتمد في السمتين. تباين السمة الداكنة 2.54:1 — دون AA. التوصية غير المطبَّقة: #0a1120" },
      "on-debit":      { "light": "#ffffff", "dark": "#ffffff", "role_ar": "نص فوق المدين", "note_ar": "تباين السمة الداكنة 1.86:1 — دون AA. التوصية غير المطبَّقة: #04231f" },
      "on-credit":     { "light": "#ffffff", "dark": "#ffffff", "role_ar": "نص فوق الدائن", "note_ar": "التوصية غير المطبَّقة: #0a1120" },
      "on-danger":     { "light": "#ffffff", "dark": "#ffffff", "role_ar": "نص فوق الخطر", "note_ar": "التوصية غير المطبَّقة: #2a0a0a" },
      "on-success":    { "light": "#ffffff", "dark": "#ffffff", "role_ar": "نص فوق النجاح", "note_ar": "التوصية غير المطبَّقة: #052e16" },
      "on-warning":    { "light": "#ffffff", "dark": "#ffffff", "role_ar": "نص فوق التحذير", "note_ar": "التوصية غير المطبَّقة: #2a1a02" },
      "on-accent-fixed": { "light": "#ffffff", "dark": "#ffffff", "role_ar": "أبيض ثابت لا يتبع السمة (زجاجة المفتاح، رمز الشعار)" },
      "shade":         { "light": "#000000", "dark": "#000000", "role_ar": "بدائية للمزج فقط — لا تُستعمل لوناً مباشراً" },
      "tint":          { "light": "#ffffff", "dark": "#ffffff", "role_ar": "بدائية للمزج فقط — لا تُستعمل لوناً مباشراً" },
      "scrim":         { "light": "rgba(8,15,30,.55)", "dark": "rgba(3,7,18,.66)", "role_ar": "تعتيم خلف النوافذ" }
    },

    "semantic": {
      "color-bg": "{color.core.bg}",
      "color-surface": "{color.core.surface}",
      "color-surface-raised": "{color.core.surface-2}",
      "color-surface-sunken": "{color.core.surface-3}",
      "color-border": "{color.core.border}",
      "color-border-strong": "{color.core.border-2}",
      "color-text": "{color.core.text}",
      "color-text-muted": "{color.core.text-2}",
      "color-text-subtle": "{color.core.text-3}",

      "color-primary": "{color.core.brand}",
      "color-primary-hover": "{color.core.brand-ink}",
      "color-primary-soft": "{color.core.brand-soft}",
      "color-focus": "{color.core.brand}",
      "color-link": "{color.core.brand}",

      "color-debit": "{color.core.debit}",
      "color-debit-soft": "{color.core.debit-soft}",
      "color-credit": "{color.core.credit}",
      "color-credit-soft": "{color.core.credit-soft}",

      "color-amount": "{color.core.text}",
      "color-amount-zero": "{color.core.text-3}",
      "color-amount-negative": "{color.core.req}",

      "color-draft": "{color.core.text-3}",
      "color-draft-soft": "{color.core.surface-3}",
      "color-posted": "{color.core.good}",
      "color-posted-soft": "{color.core.good-soft}",
      "color-posted-line": "{color.core.good-line}",
      "color-reversed": "{color.core.ai}",
      "color-reversed-soft": "{color.core.ai-soft}",
      "color-reversed-line": "{color.core.ai-line}",
      "color-pending": "{color.core.warn}",
      "color-pending-soft": "{color.core.warn-soft}",
      "color-pending-line": "{color.core.warn-line}",
      "color-rejected": "{color.core.req}",
      "color-rejected-soft": "{color.core.req-soft}",
      "color-rejected-line": "{color.core.req-line}",
      "color-archived": "{color.core.text-3}",
      "color-archived-soft": "{color.core.surface-3}",

      "color-success": "{color.core.good}",
      "color-warning": "{color.core.warn}",
      "color-danger": "{color.core.req}",
      "color-info": "{color.core.brand}",
      "color-required": "{color.core.req}",
      "color-balanced": "{color.core.good}",
      "color-unbalanced": "{color.core.warn}",
      "color-ai": "{color.core.ai}"
    }
  },

  "print_color": {
    "$note_ar": "لوحة الطباعة. لا تتبع السمة: الورق أبيض دائماً — انظر theme-default.css §٤.",
    "paper":       { "value": "#ffffff", "role_ar": "الورق" },
    "ink":         { "value": "#000000", "role_ar": "الحبر الأساسي" },
    "ink-2":       { "value": "#333333", "role_ar": "حبر ثانوي" },
    "ink-3":       { "value": "#444444", "role_ar": "حبر خافت" },
    "ink-4":       { "value": "#555555", "role_ar": "تسمية" },
    "rule":        { "value": "#000000", "role_ar": "خطّ فاصل رئيسي" },
    "rule-2":      { "value": "#666666", "role_ar": "خطّ فاصل ثانوي" },
    "rule-3":      { "value": "#999999", "role_ar": "خطّ فاصل خافت" },
    "fill":        { "value": "#f0f0f0", "role_ar": "تظليل رأس/إجمالي" },
    "debit-bg":    { "value": "#e6f6f3", "role_ar": "خلفية رأس المدين" },
    "debit-rule":  { "value": "#0f9d8f", "role_ar": "خطّ رأس المدين" },
    "debit-ink":   { "value": "#0b6f65", "role_ar": "حبر مبلغ المدين" },
    "credit-bg":   { "value": "#e8f0fe", "role_ar": "خلفية رأس الدائن" },
    "credit-rule": { "value": "#3b82f6", "role_ar": "خطّ رأس الدائن" },
    "credit-ink":  { "value": "#1d4ed8", "role_ar": "حبر مبلغ الدائن" },
    "watermark":   { "value": "rgba(0,0,0,.10)", "role_ar": "ختم المسودة" }
  },

  "shadow": {
    "shadow-1":      { "light": "0 1px 2px rgba(15,23,42,.05)", "dark": "0 1px 2px rgba(0,0,0,.4)" },
    "shadow-2":      { "light": "0 1px 2px rgba(15,23,42,.04), 0 10px 26px -14px rgba(15,23,42,.22)", "dark": "0 1px 2px rgba(0,0,0,.3), 0 12px 28px -16px rgba(0,0,0,.8)" },
    "shadow-brand":  { "light": "0 6px 16px -8px color-mix(in srgb, var(--brand) 80%, transparent)", "dark": "0 6px 16px -8px color-mix(in srgb, var(--brand) 80%, transparent)" },
    "shadow-lift":   { "light": "0 6px 20px rgba(15,23,42,.10)", "dark": "0 8px 24px rgba(0,0,0,.45)" },
    "ring":          { "value": "0 0 0 3px color-mix(in srgb, var(--brand) 18%, transparent)", "role_ar": "حلقة التركيز حول الحقول" },
    "ring-inset":    { "value": "inset 0 0 0 2px var(--brand)", "role_ar": "تركيز داخل خلية جدول" }
  },

  "typography": {
    "font-sans": "'IBM Plex Sans Arabic','Segoe UI',Tahoma,system-ui,sans-serif",
    "font-mono": "ui-monospace,SFMono-Regular,'Cascadia Mono','IBM Plex Sans Arabic',monospace",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": {
      "3xs": { "value": "11.5px", "role_ar": "تلميح، شرح إحصائية، مفتاح بطاقة" },
      "2xs": { "value": "12px",   "role_ar": "عنوان عمود، مفتاح إحصائية" },
      "xs":  { "value": "12.5px", "role_ar": "تسمية حقل، فتات الخبز، رقاقة" },
      "sm":  { "value": "13px",   "role_ar": "عنصر قائمة فرعية، خلية جدول عرض" },
      "md":  { "value": "13.5px", "role_ar": "زر، تبويب، عنصر تنقّل" },
      "base":{ "value": "14px",   "role_ar": "نص الواجهة" },
      "lg":  { "value": "14.5px", "role_ar": "عنوان بطاقة" },
      "xl":  { "value": "15px",   "role_ar": "نص صفحة الفهرس" },
      "2xl": { "value": "16px",   "role_ar": "عنوان نافذة" },
      "3xl": { "value": "17px",   "role_ar": "عنوان قسم" },
      "4xl": { "value": "19px",   "role_ar": "قيمة حالة كبيرة" },
      "5xl": { "value": "21px",   "role_ar": "عنوان صفحة" },
      "6xl": { "value": "23px",   "role_ar": "قيمة إحصائية" },
      "display": { "value": "clamp(24px,4vw,32px)", "role_ar": "عنوان صفحة فهرس" }
    },
    "line-height": { "tight": 1.35, "snug": 1.5, "base": 1.6, "relaxed": 1.7, "loose": 1.75 },
    "tracking": { "title": "-.01em", "stat": "-.02em", "num": ".01em" },
    "numeric": {
      "rule_ar": "كل عمود مبالغ يحمل font-variant-numeric:tabular-nums و dir=\"ltr\" على العنصر الحامل للرقم.",
      "font-variant-numeric": "tabular-nums"
    }
  },

  "space": {
    "0": "0", "2": "2px", "4": "4px", "6": "6px", "8": "8px", "10": "10px",
    "12": "12px", "14": "14px", "16": "16px", "18": "18px", "20": "20px",
    "24": "24px", "32": "32px", "48": "48px", "64": "64px"
  },

  "radius": {
    "xs": "4px", "sm": "8px", "md": "9px", "lg": "12px", "xl": "16px",
    "pill": "999px", "circle": "50%",
    "aliases": { "r": "12px", "r-sm": "8px" }
  },

  "border": { "width": "1px", "width-strong": "1.5px", "width-accent": "2px" },

  "motion": {
    "fast": "0.12s", "base": "0.15s", "slow": "0.2s", "ease": "ease",
    "rule_ar": "كل حركة تُلغى تحت prefers-reduced-motion:reduce."
  },

  "z-index": {
    "table-head": 2, "menu": 20, "actionbar": 50, "topbar": 60,
    "drawer": 90, "overlay": 100, "toast": 120
  },

  "layout": {
    "topbar-h": "56px",
    "sidenav-w": "216px",
    "control-h": "38px",
    "control-h-sm": "34px",
    "cell-h": "42px",
    "control-pad-x": "11px",
    "control-pad-y": "8px",
    "page-pad-x": "20px",
    "page-pad-x-sm": "14px"
  },

  "breakpoints": {
    "xs": "440px", "sm": "520px", "md": "620px", "lg": "760px",
    "nav": "860px", "xl": "980px", "2xl": "1180px",
    "note_ar": "860px هو الانكسار الحاكم: عنده يختفي الشريط الجانبي ويصير درجاً."
  },

  "format": {
    "money": {
      "scale": 4,
      "display_scale": 2,
      "rule_ar": "المبلغ decimal لا float. يُرسل من الخادم كنصّ بمقياس ثابت، وتُضيف الواجهة فواصل الآلاف فقط. لا Intl معتمِد على لغة الجهاز.",
      "grouping": ",",
      "decimal": ".",
      "digits": "latin",
      "trap": "docs/evidence/traps.md#fakh-18"
    },
    "date": {
      "stored": "gregorian",
      "displayed": "user preference: gregorian | umm-al-qura hijri",
      "input_format": "YYYY/MM/DD",
      "rule_ar": "التخزين ميلادي دائماً. الهجري عرض فقط ولا يعود إلى التخزين أبداً."
    }
  }
}
