<Project Sdk="Microsoft.NET.Sdk">

  <!-- مُولِّد ومتحقّق المتجهات الذهبية. يخرج برمز غير صفري عند أي انحراف. انظر README. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Babel.Canonicalization.Golden</RootNamespace>
    <AssemblyName>Babel.Canonicalization.Golden</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!-- أداة تشغيل لا مكتبة عامة؛ الشرح في README ولا حاجة لتعليق XML على كل عضو. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Babel.Canonicalization/Babel.Canonicalization.csproj" />
  </ItemGroup>

</Project>
