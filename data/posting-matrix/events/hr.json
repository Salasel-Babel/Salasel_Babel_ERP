  "events": [
    {
      "event_code": "hr.payroll.accrual",
      "name_ar": "استحقاق الرواتب",
      "name_en": "Payroll accrual",
      "module": "hr",
      "status": "drafted",
      "source_ref": "posting-matrix.md §7.1",
      "trigger": {
        "name_ar": "عند اعتماد مسيّر الرواتب للفترة",
        "name_en": "On approval of the payroll run for the period"
      },
      "posts_entry": true,
      "reversal": {
        "name_ar": "قيد عكسي مستقل — لا يُعدَّل مسيّر مرحّل",
        "name_en": "A separate reversing entry — a posted payroll run is never edited"
      },
      "caveats": [
        {
          "ref": "posting-matrix.md بند مفتوح 4",
          "text_ar": "⚠️ قاعدة توزيع تكلفة الموظف على المشاريع (بساعات العمل أم بنسبة تخصيص ثابتة أم بأيام الحضور) غير محسومة — وهي الرابط بين وحدتي الموارد البشرية والمقاولات",
          "text_en": "⚠️ The rule for allocating employee cost to projects (by logged hours a fixed allocation ratio or attendance days) is unresolved — it is the real link between HR and contracting"
        },
        {
          "ref": "CONTRIBUTING §3.6",
          "text_ar": "نسب التأمينات لا تُخترع في هذا التسليم ولا تُثبَّت في الكود — تُقرأ من جدول إعدادات يعتمده المحاسب",
          "text_en": "Social insurance rates are not invented in this deliverable and never hard-coded — they are read from a settings table approved by the accountant"
        }
      ],
      "amounts": {
        "gross_entitlements": {
          "name_ar": "إجمالي مستحقات الموظفين",
          "name_en": "Total employee entitlements",
          "derivation_ar": "الرواتب الأساسية والبدلات والإضافي من مسيّر الرواتب",
          "derivation_en": "Basic salaries allowances and overtime from the payroll run"
        },
        "employer_social_insurance": {
          "name_ar": "حصة المنشأة في التأمينات",
          "name_en": "Employer social insurance share",
          "derivation_ar": "بالنسب المخزّنة في جدول إعدادات التأمينات — لا نسبة في الكود ولا نسبة مخترعة هنا",
          "derivation_en": "At the rates stored in the social insurance settings table — no rate in code and no rate invented here"
        },
        "employee_social_insurance": {
          "name_ar": "حصة الموظف في التأمينات",
          "name_en": "Employee social insurance share",
          "derivation_ar": "بالنسب المخزّنة في جدول الإعدادات",
          "derivation_en": "At the rates stored in the settings table"
        },
        "advance_installment": {
          "name_ar": "قسط سلفة الموظف المستقطع",
          "name_en": "Employee advance instalment deducted",
          "derivation_ar": "من جدول سداد السلفة",
          "derivation_en": "From the advance repayment schedule"
        },
        "deductions": {
          "name_ar": "الخصومات والجزاءات",
          "name_en": "Deductions and penalties",
          "derivation_ar": "من سجل الجزاءات المعتمد",
          "derivation_en": "From the approved penalties register"
        },
        "net_payable": {
          "name_ar": "صافي المستحق للموظفين",
          "name_en": "Net payable to employees",
          "derivation_ar": "الإجمالي ناقص حصة الموظف والقسط والخصومات",
          "derivation_en": "Gross less the employee share the instalment and the deductions"
        }
      },
      "identities": {
        "net_payable": "gross_entitlements - employee_social_insurance - advance_installment - deductions"
      },
      "lines": [
        {
          "line_no": 1,
          "line_kind": "role",
          "role": "salaries_expense",
          "qualifier_source": null,
          "side": "debit",
          "amount": "gross_entitlements",
          "dimensions": [
            "cost_center"
          ],
          "subledger": null,
          "when": null,
          "note_ar": "يُوزَّع على المشاريع ومراكز التكلفة بقاعدة التوزيع المعتمدة",
          "note_en": "Allocated across projects and cost centres by the approved allocation rule"
        },
        {
          "line_no": 2,
          "line_kind": "role",
          "role": "employer_social_insurance_expense",
          "qualifier_source": null,
          "side": "debit",
          "amount": "employer_social_insurance",
          "dimensions": [
            "cost_center"
          ],
          "subledger": null,
          "when": null,
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 3,
          "line_kind": "role",
          "role": "salaries_payable",
          "qualifier_source": null,
          "side": "credit",
          "amount": "net_payable",
          "dimensions": [],
          "subledger": "employee",
          "when": null,
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 4,
          "line_kind": "role",
          "role": "social_insurance_payable",
          "qualifier_source": null,
          "side": "credit",
          "amount": "employee_social_insurance + employer_social_insurance",
          "dimensions": [],
          "subledger": null,
          "when": null,
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 5,
          "line_kind": "role",
          "role": "employee_advance",
          "qualifier_source": null,
          "side": "credit",
          "amount": "advance_installment",
          "dimensions": [],
          "subledger": "employee",
          "when": null,
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 6,
          "line_kind": "role",
          "role": "payroll_deductions_payable",
          "qualifier_source": null,
          "side": "credit",
          "amount": "deductions",
          "dimensions": [],
          "subledger": "employee",
          "when": null,
          "note_ar": "",
          "note_en": ""
        }
      ]
    },
