<Project Sdk="Microsoft.NET.Sdk">

  <!--
    مزوّد وهمي كامل التنفيذ. لا شبكة، لا اعتمادات، لا شهادات في المستودع.
    كل مفتاح يُولَّد في الذاكرة عند التشغيل ويموت مع العملية.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Babel.Compliance.FakeProvider</RootNamespace>
    <AssemblyName>Babel.Compliance.FakeProvider</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Babel.Compliance.Abstractions/Babel.Compliance.Abstractions.csproj" />
  </ItemGroup>

</Project>
