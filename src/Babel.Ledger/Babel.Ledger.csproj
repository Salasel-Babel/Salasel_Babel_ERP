<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Babel.Ledger — دفتر الأستاذ. إلزامي دائماً ولا يكون اختيارياً أبداً.
    الجهة الوحيدة في النظام كله التي تكتب قيداً، والجهة الوحيدة التي تعرف رقم حساب.
    Ledger لا تعتمد على أي وحدة أعلى منها — أبداً (Rule03).
    ولا وحدة أفقية تعتمد على Ledger — لا مرجع مشروع أصلاً (Rule01).

    ومكتبة التوحيد القياسي مسموحة هنا وحدها (Rule11 · ModuleMap): الدفتر هو الجهة
    الوحيدة التي تُجزّئ قيداً.
  -->

  <PropertyGroup>
    <RootNamespace>Babel.Ledger</RootNamespace>
    <AssemblyName>Babel.Ledger</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Babel.SharedKernel/Babel.SharedKernel.csproj" />
    <ProjectReference Include="../Babel.Contracts/Babel.Contracts.csproj" />
    <ProjectReference Include="../Babel.Core/Babel.Core.csproj" />
    <ProjectReference Include="../Babel.Canonicalization/Babel.Canonicalization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    المخطّط الحيّ: الهجرة تنفّذ هذه النصوص حرفياً. مضمَّنة في التجميعة كي لا يعتمد
    النشر على وجود شجرة المستودع على القرص.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/*.sql" />
  </ItemGroup>

  <!--
    مصفوفة الترحيل بيانات منتج تُنشر مع الثنائي: الحدث وسطوره وقواعد الحجب.
    (خريطة الدور⇒الحساب بيانات مستأجر وتعيش في قاعدة البيانات لا هنا.)
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../data/posting-matrix/events/*.json">
      <LogicalName>Babel.Ledger.Matrix.Events.%(Filename).json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../data/posting-matrix/guard-rules.json">
      <LogicalName>Babel.Ledger.Matrix.guard-rules.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    مشاريع الاختبار وحدها ترى داخل الدفتر. و«الاختبار داخل حدّ الثقة» ليس تساهلاً:
    البديل هو أن يبقى PostingService نوعاً عاماً كي تراه وصلة اختبار — فيراه معه
    كل مستهلك في الشجرة، ويصير حلّ النوع الملموس بدل IPostingService ممكناً.
    والسطران الثاني والثالث يزولان متى انتقلت وصلتا Sales و Purchasing إلى مصنع
    معلَن (انظر LedgerSchema ونظيره المقترح للمحرّك في تقرير التسليم).
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Babel.Ledger.Tests" />
    <InternalsVisibleTo Include="Babel.Sales.Tests" />
    <InternalsVisibleTo Include="Babel.Purchasing.Tests" />
    <InternalsVisibleTo Include="Babel.Inventory.Tests" />
    <InternalsVisibleTo Include="Babel.RealEstate.Tests" />
    <InternalsVisibleTo Include="Babel.Hr.Tests" />
  </ItemGroup>

</Project>
