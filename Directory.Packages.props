<Project>

  <!--
    مصدر الحقيقة الوحيد لإصدارات الحزم.
    قاعدة من وثيقة المعمارية §2.1: «الرقم الملزم هو ما يحلّه dotnet restore وقت التنفيذ، لا ما في وثيقة.»
    ولذلك تُثبَّت هنا، ويُسجَّل جدول الحزم المحلولة مع كل ترقية.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="الاستمرارية — EF Core 10 + Npgsql (مقيس)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- أدوات وقت التصميم للهجرات فقط: PrivateAssets=all فلا تصل إلى أي ناتج نشر. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup Label="الاستضافة وحقن الاعتماديات">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!-- الحاوية نفسها (لا عقدها وحده): يحتاجها مُنشئ الشركة التجريبية تحت demo/ كي
         يركّب الوحدات بالطريق المعلَن AddBabel<Module> بدل بلوغ أنواعها الداخلية. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <!-- تجريد التسجيل وحده: الوحدات تسجّل ولا تختار مزوّد تسجيل. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!--
    Wolverine 6.29.2 هي حزمة الرسائل المعتمدة (spikes/relational-stack/VERDICT.md §5).
    تُثبَّت هنا الآن ويُربط الوسيط في موجة الرسائل، لا في الهيكل.
    ممنوع منعاً باتاً: WolverineFx.RuntimeCompilation — تجرّ Roslyn إلى الإنتاج (وثيقة المعمارية §2.2).
    المنع مفروض ببناء: tests/Babel.ArchitectureTests/Rule08_NoRuntimeCompilationInProduction.cs
  -->
  <ItemGroup Label="الرسائل — مثبَّتة، تُربط في موجة لاحقة">
    <PackageVersion Include="WolverineFx" Version="6.29.2" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.29.2" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.29.2" />
  </ItemGroup>

  <!--
    التوحيد القياسي لـXML (‏C14N) لمسار الفوترة الإلكترونية — «اشترِ ولا تكتب».
    الإصدار 10.0.11 مُختار **بالقياس لا بالعادة**: فهرس ثغرات NuGet يسجّل على هذه الحزمة
    ثمانية تنبيهات مميّزة على 10.0.0 وخمسة ما زالت سارية على 10.0.9، فكل إصدار حتى 10.0.9 يُسقط البناء
    (‏TreatWarningsAsErrors مع NU1903). أول إصدار خارج كل النطاقات هو 10.0.10، واخترنا
    10.0.11 لأنه يطابق إصدار بقية حزم المنصّة هنا. القياس في
    docs/evidence/measurements.md. **لا يُخفَّض هذا الرقم بلا إعادة القياس.**
  -->
  <ItemGroup Label="التوحيد القياسي لـXML — مسار الفوترة الإلكترونية">
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <!--
    حزمة المزوّد لحلقة الوكيل. **مثبَّتة برقمٍ صريح** كبقية الجدول، ويُسجَّل جدول
    الحزم المحلولة في docs/evidence/measurements.md مع كل ترقية.
    وهي تجرّ اعتمادية واحدة (‏Microsoft.Extensions.AI.Abstractions) — قِيس ذلك من
    project.assets.json لا من وثيقة.
    ولا تصل هذه الحزمة إلا Babel.Ai: مرجعُها في Babel.Ai.csproj وحده، ومسارُ الخروج
    إلى النموذج نوعٌ محايد خلف منفذ — فلا تُجَرّ إلى اختبارٍ ولا إلى سطح HTTP.
  -->
  <ItemGroup Label="مزوّد النموذج — حلقة الوكيل">
    <PackageVersion Include="Anthropic" Version="12.45.0" />
  </ItemGroup>

  <ItemGroup Label="الاختبارات وإنفاذ الحدود">
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

</Project>
