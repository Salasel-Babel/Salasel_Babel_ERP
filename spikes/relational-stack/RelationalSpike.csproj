<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BabelRelationalSpike</RootNamespace>
    <AssemblyName>BabelRelationalSpike</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);EF1001</NoWarn>
    <!--
      المسبار يثبّت إصداراته بنفسه: الرقم المقيس هو جزء من الدليل لا تفصيل بناء.
      الإدارة المركزية (Directory.Packages.props) تخدم المنتج، ولو أخضعنا المسبار لها
      لتغيّر ما قاسه كلّما رُقّي المنتج، فيصير دليلاً على شيء آخر. NU1008 كان يمنع
      الاستعادة أصلاً. السابقة نفسها في spikes/culture-calendar.
      A spike pins its own versions: the measured number is part of the evidence,
      not a build detail. Central management serves the product; subjecting the probe
      to it would silently change what it measured. NU1008 blocked restore entirely.
    -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!--
      ضجيج المحلّلات الذي لا يخصّ المسبار. الاستثناء مقصور على ما لا يمسّ الدليل:
        CS1591 — توثيق XML لكل عضو عامّ: انضباط واجهة منتج، والمسبار ليس مكتبة.
        CA1707 — الشُّرَط السفلية في الأسماء: «P1_LocalStore» و«ProofA_Outbox» هي
                 تسمية الأدلّة نفسها، وتغييرها يقطع الإحالة من docs/evidence.
        CA1861 — المصفوفات الثابتة كوسائط: ملحوظة أداء في شيفرة تُنفَّذ مرّة واحدة.
      نفس السابقة ونفس المبرّر في Directory.Build.props لمشاريع الاختبارات.
      **ولا يُضاف هنا CA1305 ولا CA1310** — قاعدتا الثقافة هما ما يُصاد لا ما يُكتم.
      Analyzer noise that is not the probe's business. Deliberately NOT suppressed:
      CA1305 / CA1310 — the culture rules are the quarry here, never silenced.
    -->
    <!--
      CA1822 خاصّة بهذا المسبار: مُعالج Wolverine يُكتشَف بالعُرف (Support/Messaging.cs)،
      وجعله static يمسّ آلية الاكتشاف نفسها التي يقيسها المسبار — ولا نغيّر ما يقيسه
      المسبار كي يُصرَّف. وسائل ProofRecorder غير ساكنة عمداً لأنها واجهة مُسجِّل.
      CA1822 is specific to this probe: the Wolverine handler is convention-discovered,
      and making it static touches the very mechanism the spike measures.
    -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1861;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Messaging: Wolverine WITHOUT Marten. -->
    <PackageReference Include="WolverineFx" Version="6.29.2" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.29.2" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.29.2" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.29.2" />

    <!-- Persistence: EF Core 10 + Npgsql. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
