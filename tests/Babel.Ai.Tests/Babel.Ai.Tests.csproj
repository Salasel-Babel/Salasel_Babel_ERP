<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Babel.Ai.Tests</RootNamespace>
    <AssemblyName>Babel.Ai.Tests</AssemblyName>
    <!-- العربية لغة أولى: بيانات المناطق مطلوبة، والتطبيع الصامت أخطر مصيدة نشر. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Babel.Ai/Babel.Ai.csproj" />
    <!--
      مشروع الاختبار — لا مشروع منتج — يشير إلى مزوّد الهيئة: المطلوب إثباته هو أن
      الفاكّ **عكس المُرمِّز القائم بالضبط**، ولا سبيل إلى ذلك إلا بالمُرمِّز نفسه.
      والقاعدتان 1 و3 تفحصان مشاريع src/ وحدها، وBabel.Purchasing.Tests سابقة قائمة
      على الشكل نفسه (تشير إلى الدفتر).

      ووحدة Babel.Ai نفسها **لا** تشير إليه ولا تستطيع: القاعدة 3 تمنع ذلك، والوصلة
      تُركَّب في الجذر التركيبي. ونسخة الوصلة الجاهزة للنقل في Support/ZatcaQrAttestationReader.cs.
    -->
    <ProjectReference Include="../../src/Babel.Compliance.Zatca/Babel.Compliance.Zatca.csproj" />
    <!--
      ومحوّل المرفقات **في الذاكرة**: الالتقاط صار يشير إلى مستند مُودَع بدل أن يحمل
      بايتاته، فالاختبار يحتاج محوّلاً للمنفذ. ويُختار المحوّل الذي لا يحتاج قرصاً ولا
      قاعدة بيانات — أمّا الشمّ والصلاحيات ومشغّل «يُضاف ولا يُعدَّل» فمُثبَتة على
      PostgreSQL حقيقية في tests/Babel.Storage.Tests/ ولا تُعاد هنا.
      ووحدة Babel.Ai نفسها لا تشير إليه ولا تستطيع (القاعدة 3): المنفذ في Babel.Contracts.
    -->
    <ProjectReference Include="../../src/Babel.Storage/Babel.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <!-- جذر المستودع يُحقن في التجميعة: الحارس المعماري يقرأ ملفات المشاريع نفسها لا IL فقط. -->
  <ItemGroup>
    <AssemblyMetadata Include="BabelRepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))" />
  </ItemGroup>

</Project>
