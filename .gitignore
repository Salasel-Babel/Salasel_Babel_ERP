# البيئة والأسرار
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets/

# البناء
bin/
obj/

# وناتج البناء نفسه مكتوباً بفاصل مسار **ويندوزي**: مضيف بناء MSBuild يكتب أحياناً
# `bin\\Debug` مقطعاً واحداً فيه شرطة خلفية، فلا يطابقه النمط `bin/` أعلاه ولا أي
# نمط يبحث عن `/bin/`. وقد أُودعت 45 قطعة بهذا الطريق مرّةً (‏839 ميغابايت)، وكانت
# **تُفشل بناء نسخة جديدة** بـMSB3552. والحارس الحقيقي اختبارٌ لا هذا السطر:
# tests/Babel.ArchitectureTests/RepositoryContainsNoBuildOutput.cs
*\\Debug/
*\\Release/
**/BuildHost-net*/
[Bb]in/
[Oo]bj/
TestResults/
*.binlog
artifacts/
dist/
build/
out/
node_modules/
*.user

# السجلات والمؤقتات
*.log
# معرّفات عمليات التشغيل المحلي (deploy/up.sh) — حالةُ جهازٍ لا شيفرة
deploy/.*.pid
deploy/previous.tag
# حالةُ مناوبة الشهادة وصنبورُ إنذارها (deploy/remote.sh rotation) — حالةُ خادمٍ لا شيفرة
deploy/certs.state
deploy/certs-alert
logs/
tmp/
.cache/

# أدوات التطوير
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# بيانات محلية
*.sqlite
*.db
uploads/
