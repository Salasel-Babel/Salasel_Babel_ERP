          "line_kind": "role",
          "role": "retention_receivable",
          "qualifier_source": null,
          "side": "debit",
          "amount": "retention",
          "dimensions": [
            "project"
          ],
          "subledger": "customer",
          "when": null,
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 3,
          "line_kind": "role",
          "role": "customer_advance",
          "qualifier_source": null,
          "side": "debit",
          "amount": "advance_recovery",
          "dimensions": [],
          "subledger": "customer",
          "when": null,
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 4,
          "line_kind": "role",
          "role": "contract_revenue",
          "qualifier_source": null,
          "side": "credit",
          "amount": "work_value",
          "dimensions": [
            "project"
          ],
          "subledger": null,
          "when": null,
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 5,
