<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Babel.Inventory.Tests</RootNamespace>
    <AssemblyName>Babel.Inventory.Tests</AssemblyName>
    <!-- العربية لغة أولى: بيانات المناطق مطلوبة، والتطبيع الصامت أخطر مصيدة نشر. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>

  <ItemGroup>
    <!--
      مشروع الاختبار — لا مشروع منتج — يشير إلى الدفتر وإلى وحدتَي المبيعات
      والمشتريات: الإثبات المطلوب هو أن دفتر المخزون المساعد يطابق حسابه الضابط في
      دفتر أستاذ **حقيقي** بعد مستندات **حقيقية** — استلام بضاعة من المشتريات وفاتورة
      مبيعات بقيد تكلفتها. ولا سبيل إلى ذلك بمحاكاة: محاكاة الدفتر تُثبت أن المحاكاة
      تعمل. والقاعدة 3 تفحص مشاريع src/ وحدها، و Babel.Sales.Tests سابقة قائمة على
      الشكل نفسه.
    -->
    <ProjectReference Include="../../src/Babel.Inventory/Babel.Inventory.csproj" />
    <ProjectReference Include="../../src/Babel.Sales/Babel.Sales.csproj" />
    <ProjectReference Include="../../src/Babel.Purchasing/Babel.Purchasing.csproj" />
    <ProjectReference Include="../../src/Babel.Ledger/Babel.Ledger.csproj" />
    <ProjectReference Include="../../src/Babel.Core/Babel.Core.csproj" />
    <ProjectReference Include="../../src/Babel.Canonicalization/Babel.Canonicalization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
