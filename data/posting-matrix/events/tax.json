      "posts_entry": true,
      "reversal": {
        "name_ar": "قيد عكسي مستقل",
        "name_en": "A separate reversing entry"
      },
      "amounts": {
        "amount": {
          "name_ar": "المبلغ المسدَّد",
          "name_en": "Amount settled",
          "derivation_ar": "رصيد الضريبة المستحقة للفترة المسدَّدة",
          "derivation_en": "The VAT payable balance for the settled period"
        }
      },
      "lines": [
        {
          "line_no": 1,
          "line_kind": "role",
          "role": "vat_payable_authority",
          "qualifier_source": null,
          "side": "debit",
          "amount": "amount",
          "dimensions": [],
          "subledger": null,
          "when": null,
          "note_ar": "",
          "note_en": ""
        },
        {
          "line_no": 2,
          "line_kind": "role",
          "role": "settlement_account",
          "qualifier_source": "constant:bank",
          "side": "credit",
          "amount": "amount",
          "dimensions": [],
          "subledger": "bank_account",
          "when": null,
          "note_ar": "",
          "note_en": ""
        }
      ]
    },
    {
      "event_code": "tax.vat.refund_received",
      "name_ar": "استلام مبلغ ضريبي مسترد من الهيئة",
      "name_en": "Receipt of a VAT refund from the authority",
      "module": "tax",
      "status": "drafted",
      "source_ref": "posting-matrix.md §9.2",
      "trigger": {
        "name_ar": "عند ورود المبلغ فعلياً في الحساب البنكي",
        "name_en": "When the amount actually arrives in the bank account"
      },
      "posts_entry": true,
      "reversal": {
        "name_ar": "قيد عكسي مستقل",
        "name_en": "A separate reversing entry"
      },
      "amounts": {
        "amount": {
          "name_ar": "المبلغ المسترد",
          "name_en": "Amount refunded",
          "derivation_ar": "من إشعار البنك لا من قرار الهيئة وحده",
          "derivation_en": "From the bank advice not from the authority decision alone"
        }
      },
      "lines": [
        {
          "line_no": 1,
          "line_kind": "role",
          "role": "settlement_account",
          "qualifier_source": "constant:bank",
          "side": "debit",
          "amount": "amount",
          "dimensions": [],
          "subledger": "bank_account",
          "when": null,
          "note_ar": "",
